# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Radarr (now runs on docker01, not the NAS)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=changeme-rotated-radarr-key

# OMDb (IMDb + Rotten Tomatoes + Metacritic). Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=changeme

# TMDb (genres, keywords, popularity). Default below is Radarr's public shared key.
TMDB_API_KEY=1a7373301961d03f97f853a876dd1212

# Local SQLite state (ratings cache, keep-list, run history, deletion audit)
JANITOR_DB=janitor.db
CACHE_TTL_DAYS=90

# Telegram notifications for the quarterly report
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web UI HTTP Basic Auth (leave both blank to disable; set for janitor.dangericke.com)
WEB_USER=
WEB_PASSWORD=

VERIFY_SSL=true
LOG_LEVEL=INFO
